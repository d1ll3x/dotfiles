# ~/.config/zsh/.zstyles

# Completions
zstyle ':zephyr:plugin:completion' 'use-cache' 'yes'
zstyle ':zephyr:plugin:completion' 'use-xdg-basedirs' 'yes'
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'                       # Recommended alias cd='z'

# Editor
zstyle ':zephyr:plugin:editor' magic-enter yes
zstyle ':zephyr:plugin:editor:magic-enter' git-command 'git status -sb && eza -lah --icons --git'
zstyle ':zephyr:plugin:editor:magic-enter' command 'eza -lah --icons --git'

# History
zstyle ':zephyr:plugin:history' 'use-xdg-basedirs' 'yes'
zstyle ':zephyr:plugin:history:alias' 'skip' 'yes'
