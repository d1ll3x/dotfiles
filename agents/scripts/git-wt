#!/usr/bin/env bash
# git wt: start a task on a new branch in its own worktree.
# Follows ~/.agents/docs/git.md "Branches": the worktree directory is the branch name with
# / replaced by -, next to main/ in a bare layout, else under ~/worktrees/<repo>.
# Bases on the freshly fetched trunk of origin, or on local main without a remote.
# Usage: git wt <type>/<name>    (prints the worktree path)
set -euo pipefail

[[ $# -eq 1 && $1 != -* ]] || { echo "usage: git wt <type>/<name>" >&2; exit 2; }
branch=$1
python3 "$HOME/.agents/hooks/conventions.py" branch "$branch"

common=$(git rev-parse --path-format=absolute --git-common-dir)
if [[ $(basename "$common") == .bare ]]; then
  root=$(dirname "$common")
else
  root=$HOME/worktrees/$(basename "$(dirname "$common")")
fi

if git -C "$common" remote get-url origin >/dev/null 2>&1; then
  git -C "$common" fetch --quiet origin
  if git -C "$common" ls-remote --exit-code --heads origin "refs/heads/$branch" >/dev/null; then
    echo "git wt: $branch already exists on origin" >&2
    exit 1
  fi
  base=$(git -C "$common" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/main)
else
  base=main
fi

path=$root/${branch//\//-}
git -C "$common" worktree add "$path" -b "$branch" --no-track "$base" >&2
echo "$path"
