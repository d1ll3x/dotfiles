#!/usr/bin/env bash
# git sweep: after merging PRs, update trunk and drop merged task branches.
# Follows ~/.agents/docs/git.md "Clean up merged branches":
#   fetch -> ff-only pull of trunk -> for each branch whose PR is MERGED:
#   remove its worktree, delete the local branch, delete the remote branch -> prune.
# Merged = `gh pr view <branch>` state MERGED (squash/rebase merges hide it from git).
# A dirty worktree is never removed: it is reported and skipped.
# Usage: git sweep [-n|--dry-run]
set -euo pipefail

dry=false
case "${1:-}" in
  -n | --dry-run) dry=true ;;
  "") ;;
  *) echo "usage: git sweep [-n|--dry-run]" >&2; exit 2 ;;
esac
run() { if $dry; then echo "  (dry-run) $*"; else "$@"; fi; }

common=$(cd "$(git rev-parse --git-common-dir)" && pwd)
trunk=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
trunk=${trunk:-main}

# Worktree that has trunk checked out (bare layout: <container>/main).
trunk_wt=$(git worktree list --porcelain | awk -v b="refs/heads/$trunk" '
  /^worktree /{wt=substr($0,10)} $0=="branch " b {print wt}')

echo "==> fetch"
git -C "$common" fetch --prune origin

if [[ -n "$trunk_wt" ]]; then
  echo "==> $trunk ($trunk_wt)"
  if [[ -n "$(git -C "$trunk_wt" status --porcelain)" ]]; then
    echo "  dirty: not pulling. Commit on a task branch or clean it first." >&2
  else
    run git -C "$trunk_wt" pull --ff-only
  fi
fi

echo "==> merged branches"
while read -r branch; do
  [[ "$branch" == "$trunk" ]] && continue
  state=$(gh pr view "$branch" --json state -q .state 2>/dev/null || echo NONE)
  [[ "$state" == MERGED ]] || continue

  wt=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '
    /^worktree /{wt=substr($0,10)} $0=="branch " b {print wt}')
  if [[ -n "$wt" ]]; then
    if [[ -n "$(git -C "$wt" status --porcelain --untracked-files=normal)" ]]; then
      echo "  skip $branch: worktree $wt has uncommitted changes" >&2
      continue
    fi
    echo "  remove worktree $wt"
    run git -C "$common" worktree remove --force "$wt" # --force: ignored files (.terraform/) only; dirtiness checked above
  fi
  echo "  delete $branch"
  run git -C "$common" branch -D "$branch"
  if git -C "$common" ls-remote --exit-code --heads origin "$branch" >/dev/null; then
    echo "  delete origin/$branch"
    run git -C "$common" push origin --delete "$branch"
  fi
done < <(git -C "$common" for-each-ref --format='%(refname:short)' refs/heads)

# Remote branches whose PR merged but that have no local branch (e.g. pushed from elsewhere).
while read -r rbranch; do
  [[ "$rbranch" == "$trunk" || "$rbranch" == HEAD ]] && continue
  git -C "$common" show-ref --quiet "refs/heads/$rbranch" && continue
  state=$(gh pr view "$rbranch" --json state -q .state 2>/dev/null || echo NONE)
  [[ "$state" == MERGED ]] || continue
  echo "  delete origin/$rbranch (no local branch)"
  run git -C "$common" push origin --delete "$rbranch"
done < <(git -C "$common" for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin)

echo "==> prune"
run git -C "$common" fetch --prune origin
run git -C "$common" worktree prune

echo "==> status"
git -C "$common" worktree list
git -C "$common" for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads
